# apps/api environment. Copy to .env for local runs; never commit real values (QP-STD-006).
PORT=4000
DATABASE_URL=postgresql://quantpilot:change-me@localhost:5432/quantpilot
REDIS_URL=redis://localhost:6379
QUANT_URL=http://localhost:8000
QUANT_TIMEOUT_MS=60000
CORS_ORIGIN=http://localhost:3000
# Run the BullMQ backtest worker in this process (true/false).
RUN_WORKER=true
