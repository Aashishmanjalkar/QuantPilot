# Root .env for `docker compose up`. Copy to .env and change values; .env is git-ignored
# (QP-STD-006). Per-service variables are documented in apps/api/.env.example and
# services/quant/.env.example.
# Must be URL-safe (letters, digits, - _ . ~): it is embedded in postgresql:// URLs.
POSTGRES_PASSWORD=change-me
# yfinance (live, unofficial) or fixture (offline synthetic DEMO ticker).
QUANT_DATA_PROVIDER=yfinance
# Host ports (bound to 127.0.0.1).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000
