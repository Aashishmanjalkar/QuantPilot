{
  "$defs": {
    "Costs": {
      "additionalProperties": false,
      "properties": {
        "commission_bps": {
          "default": 5.0,
          "description": "Commission per fill in basis points of traded notional.",
          "maximum": 1000,
          "minimum": 0,
          "title": "Commission Bps",
          "type": "number"
        },
        "slippage_bps": {
          "default": 5.0,
          "description": "Adverse price slippage per fill in basis points of the open price.",
          "maximum": 1000,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        }
      },
      "title": "Costs",
      "type": "object"
    },
    "PositionSizing": {
      "additionalProperties": false,
      "properties": {
        "fraction": {
          "default": 1.0,
          "description": "Fraction of equity invested on entry.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Fraction",
          "type": "number"
        },
        "kind": {
          "const": "fraction_of_equity",
          "default": "fraction_of_equity",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "PositionSizing",
      "type": "object"
    },
    "RsiCondition": {
      "additionalProperties": false,
      "description": "True on a bar when RSI(period) at that bar's close is below/above threshold.",
      "properties": {
        "indicator": {
          "const": "rsi",
          "default": "rsi",
          "title": "Indicator",
          "type": "string"
        },
        "operator": {
          "enum": [
            "below",
            "above"
          ],
          "title": "Operator",
          "type": "string"
        },
        "period": {
          "description": "RSI lookback in bars (Wilder smoothing).",
          "maximum": 100,
          "minimum": 2,
          "title": "Period",
          "type": "integer"
        },
        "threshold": {
          "maximum": 100,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "period",
        "operator",
        "threshold"
      ],
      "title": "RsiCondition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A long-only single-ticker strategy driven by RSI entry/exit conditions.",
  "properties": {
    "costs": {
      "$ref": "#/$defs/Costs",
      "default": {
        "commission_bps": 5.0,
        "slippage_bps": 5.0
      }
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/RsiCondition"
    },
    "exit": {
      "$ref": "#/$defs/RsiCondition"
    },
    "initial_capital": {
      "exclusiveMinimum": 0,
      "maximum": 1000000000000.0,
      "title": "Initial Capital",
      "type": "number"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "position_sizing": {
      "$ref": "#/$defs/PositionSizing",
      "default": {
        "fraction": 1.0,
        "kind": "fraction_of_equity"
      }
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "ticker": {
      "description": "Upper-case ticker, e.g. AAPL or RELIANCE.NS.",
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[A-Z0-9][A-Z0-9.\\-^]{0,19}$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "name",
    "ticker",
    "start_date",
    "end_date",
    "initial_capital",
    "entry",
    "exit"
  ],
  "title": "Strategy",
  "type": "object"
}
